# Skopiuj ten plik do `.env` i dostosuj wartości

# --- Konfiguracja modelu LLM ---
# Domyślnie: lokalne Ollama z modelem llama3.2.
# Aby użyć innego serwera (np. OpenAI), zmień base_url i klucz API.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# --- Parametry generacji ---
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=1024

# --- Kontrola kontekstu ---
MAX_CONTEXT_TOKENS=3000
MAX_HISTORY_MESSAGES=20

# --- Inne ---
REQUEST_TIMEOUT=60
